{
  "name": "mobile-automation-github",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto de automação mobile para o native-demo-app com WebdriverIO, Appium, Mocha, Chai e Allure.",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:android": "cross-env PLATFORM=android wdio run wdio.conf.js",
    "test:ios": "cross-env PLATFORM=ios wdio run wdio.conf.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "appium-uiautomator2-driver": "^8.5.0",
    "chai": "^5.2.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1"
  },
  "dependencies": {
    "appium": "^3.7.0"
  }
}
